ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://estoca:estoca@postgres:5432/estoca
TEST_DATABASE_URL=postgresql+asyncpg://estoca:estoca@postgres:5432/estoca_test
CORS_ORIGINS=http://localhost:3000

SESSION_COOKIE_NAME=estoca_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_INACTIVITY_MINUTES=120
SESSION_MAX_AGE_HOURS=24

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=120

CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters
